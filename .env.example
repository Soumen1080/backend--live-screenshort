# Server Configuration
PORT=5000

# Base URL for generating screenshot links (REQUIRED for production)
# Use your deployed backend URL (e.g., from Railway, Render, etc.)
# Example: https://your-app.railway.app
BASE_URL=http://localhost:5000

# MongoDB Configuration (REQUIRED)
# Get your MongoDB URI from MongoDB Atlas: https://www.mongodb.com/atlas
# The app REQUIRES MongoDB to store screenshot jobs, links, and statistics
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# Screenshot Service Configuration
SCREENSHOT_INTERVAL=15000
MAX_SCREENSHOTS_PER_URL=1
NODE_ENV=development
